    "components": {
        "schemas": {
            "AuthData": {
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                    },
                    "token_type": {
                        "type": "string",
                        "example": "bearer"
                    },
                    "expires_in": {
                        "type": "integer",
                        "example": 3600
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "ApiSuccessResponse": {
                "required": [
                    "success",
                    "message"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Operación exitosa."
                    }
                },
                "type": "object"
            },
            "ApiErrorResponse": {
                "required": [
                    "success",
                    "message",
                    "errors"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Ocurrió un error."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "from": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 5
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 10
                    },
                    "to": {
                        "type": "integer",
                        "example": 10,
                        "nullable": true
                    },
                    "total": {
                        "type": "integer",
                        "example": 50
                    }
                },
                "type": "object"
            },
            "PaginationLinks": {
                "properties": {
                    "first": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                    },
                    "last": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                    },
                    "previous": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                    },
                    "next": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ApiSuccessResponse"
                    },
                    {
                        "properties": {
                            "data": {
                                "$ref": "#/components/schemas/AuthData"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "ProductResponse": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ApiSuccessResponse"
                    },
                    {
                        "properties": {
                            "data": {
                                "$ref": "#/components/schemas/Product"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "ProductListResponse": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ApiSuccessResponse"
                    },
                    {
                        "properties": {
                            "data": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            },
                            "meta": {
                                "$ref": "#/components/schemas/PaginationMeta"
                            },
                            "links": {
                                "$ref": "#/components/schemas/PaginationLinks"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "OrderItem": {
                "required": [
                    "id",
                    "product_id",
                    "product_name",
                    "unit_price",
                    "quantity",
                    "line_total"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "product_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "product_name": {
                        "type": "string",
                        "example": "Camiseta"
                    },
                    "unit_price": {
                        "type": "string",
                        "format": "decimal",
                        "example": "19.99"
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 2
                    },
                    "line_total": {
                        "type": "string",
                        "format": "decimal",
                        "example": "39.98"
                    },
                    "product": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Product"
                            }
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Order": {
                "required": [
                    "id",
                    "status",
                    "currency",
                    "subtotal",
                    "total",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "status": {
                        "type": "string",
                        "example": "pending",
                        "enum": [
                            "pending",
                            "paid",
                            "processing",
                            "shipped",
                            "completed",
                            "cancelled"
                        ]
                    },
                    "currency": {
                        "type": "string",
                        "example": "USD"
                    },
                    "subtotal": {
                        "type": "string",
                        "format": "decimal",
                        "example": "39.98"
                    },
                    "total": {
                        "type": "string",
                        "format": "decimal",
                        "example": "39.98"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        },
                        "nullable": true
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Payment"
                        },
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Payment": {
                "required": [
                    "id",
                    "order_id",
                    "stripe_payment_intent_id",
                    "status",
                    "amount_minor",
                    "currency"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "order_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "stripe_payment_intent_id": {
                        "type": "string",
                        "example": "pi_3MtwBwLkdIwHu7ix28a3tqPa"
                    },
                    "status": {
                        "type": "string",
                        "example": "succeeded",
                        "enum": [
                            "pending",
                            "succeeded",
                            "processing",
                            "requires_action",
                            "requires_payment_method",
                            "failed",
                            "cancelled"
                        ]
                    },
                    "amount_minor": {
                        "type": "integer",
                        "example": 3998
                    },
                    "currency": {
                        "type": "string",
                        "example": "USD"
