                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token ausente o inválido"
                    },
                    "404": {
                        "description": "Orden no encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/orders/{order}/payments": {
            "get": {
                "tags": [
                    "Payments"
                ],
                "summary": "Obtener pagos de una orden",
                "operationId": "a88a0a6a743253c9e790addb4f2bcf11",
                "parameters": [
                    {
                        "name": "order",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    },
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Clave para repetir de forma segura la misma solicitud de pago.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "order-1-payment-attempt-1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pagos obtenidos exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentListResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token ausente o inválido"
                    },
                    "404": {
                        "description": "Orden no encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Procesar un pago de Stripe para una orden",
                "description": "Crea y confirma un PaymentIntent usando el método de pago creado por Stripe.js. El importe siempre se calcula desde la orden.",
                "operationId": "0a9bed985e4b0a349a25f91388833fc0",
                "parameters": [
                    {
                        "name": "order",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PaymentInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pago procesado o requiere una acción adicional",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token ausente o inválido"
                    },
                    "403": {
                        "description": "La orden no pertenece al usuario autenticado"
                    },
                    "404": {
                        "description": "Orden no encontrada"
                    },
                    "422": {
                        "description": "Error de validación o rechazo de Stripe"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/payments/stripe/webhook": {
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Recibir eventos de Stripe",
                "operationId": "1264c8528ce91708bbd8f52167998e81",
                "parameters": [
                    {
                        "name": "Stripe-Signature",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "t=1614265330,v1=..."
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Evento procesado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WebhookResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Firma o evento inválido"
                    }
                }
            }
        },
        "/products": {
